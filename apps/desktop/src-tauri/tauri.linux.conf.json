{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Deep Research and agent monitoring with Muse Code",
    "homepage": "https://github.com/aleff-ferreira/ancilla",
    "externalBin": [],
    "resources": ["resources/server.cjs", "resources/frontend", "resources/legal", "resources/node"],
    "linux": {
      "deb": {
        "section": "devel",
        "depends": ["bash", "curl", "ca-certificates"]
      },
      "rpm": {
        "depends": ["bash", "/usr/bin/curl", "ca-certificates"]
      }
    }
  }
}
