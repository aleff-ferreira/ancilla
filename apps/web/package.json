{
  "name": "@ancilla/web",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.19.0",
  "description": "Ancilla web app: shared UI wired to the local server over REST and SSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --host 0.0.0.0 --port 5299 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "serve": "node ../../packages/server/dist/src/cli.js --port 3127 --static ./dist",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@ancilla/ui": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@ancilla/server": "*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
